---
export const prerender = true;

import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
import Shield from '@/components/icons/Shield.astro';
import CheckCircle from '@/components/icons/CheckCircle.astro';
import AlertTriangle from '@/components/icons/AlertTriangle.astro';
import founderPhoto from '@/assets/founder/abdul-mannan.png';

const FOUNDER = {
  name: 'Abdul Mannan',
  // "CEO" implies formal corporate structure; the business isn't
  // registered yet, so this stays "Founder" until it is.
  title: 'Founder',
  portfolioUrl: 'https://abdul-mannan-portfolio-umber.vercel.app/',
};

const principles = [
  {
    icon: CheckCircle,
    title: 'Findings you can act on',
    description:
      'Every report is prioritized by real-world impact, not just automated scanner output.',
  },
  {
    icon: Shield,
    title: 'No scare tactics',
    description:
      'We explain risk in plain terms and let the findings speak for themselves.',
  },
  {
    icon: AlertTriangle,
    title: 'Honest about limits',
    description:
      "If something is outside our scope or expertise, we'll tell you — and point you in the right direction.",
  },
];
---

<BaseLayout
  title="About"
  description="VantriqSec helps Pakistani businesses assess and reduce real security risk — assessments powered by KingSec, our own assessment platform. Clear communication, no scare tactics."
>
  <section class="border-b border-surface-800 bg-surface-950">
    <div class="mx-auto max-w-3xl px-6 py-20 text-center">
      <SectionHeading
        eyebrow="About us"
        title="Security work built on clarity, not fear"
        align="center"
      />
      <p class="mt-6 text-lg text-text-secondary">
        VantriqSec exists because too many businesses either get ignored by
        security vendors focused on large enterprises, or get sold fear instead of a
        plan. We work directly with growing organizations to find real risk, explain
        it clearly, and help fix it.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <SectionHeading title="How we work" />
    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {
        principles.map(({ icon: Icon, title, description }) => (
          <Card>
            <Icon class="h-8 w-8 text-brand-500" />
            <h3 class="mt-4 text-lg font-semibold text-text-primary">{title}</h3>
            <p class="mt-2 text-sm text-text-secondary">{description}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <section class="border-t border-surface-800 bg-surface-900">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <SectionHeading
        eyebrow="Our platform"
        title="Powered by KingSec"
        description="KingSec is our own external security assessment platform — six professional scanners (Nmap, Nuclei, Nikto, FFUF, Gobuster, OWASP ZAP) orchestrated into one workflow, producing a single report with findings, severity ratings, supporting evidence, and remediation guidance."
        align="center"
      />
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <Card>
          <h3 class="text-lg font-semibold text-text-primary">Why we built it</h3>
          <p class="mt-2 text-sm text-text-secondary">
            Off-the-shelf scanners produce raw output — thousands of lines that
            nobody reads. We built KingSec to normalize scanner findings into
            reports a business owner can understand and a developer can act on:
            what we found, why it matters, and how to fix it.
          </p>
        </Card>
        <Card>
          <h3 class="text-lg font-semibold text-text-primary">How we use it</h3>
          <p class="mt-2 text-sm text-text-secondary">
            KingSec powers our flagship external security assessment service.
            Our team operates the platform against your agreed scope — it's the
            engine behind the assessment, not a product we resell. Every
            engagement still starts with a scoping call and a signed scope
            agreement.
          </p>
        </Card>
      </div>
      <div class="mt-8 text-center">
        <Button href="/services" variant="secondary">See the assessment service</Button>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-800 bg-surface-950">
    <div class="mx-auto max-w-4xl px-6 py-20">
      <SectionHeading eyebrow="Leadership" title="Founder" align="center" />
      <div class="mt-10 flex flex-col items-center gap-6 text-center sm:flex-row sm:items-start sm:gap-8 sm:text-left">
        <div class="h-32 w-32 shrink-0 overflow-hidden rounded-full border border-surface-800 sm:h-48 sm:w-48">
          <Picture
            src={founderPhoto}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            width={192}
            height={192}
            quality={82}
            loading="lazy"
            alt="Abdul Mannan"
            class="h-full w-full object-cover"
          />
        </div>
        <div>
          <h3 class="text-xl font-semibold text-text-primary">{FOUNDER.name}</h3>
          <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-brand-500">
            {FOUNDER.title}
          </p>
          <p class="mt-4 text-text-secondary">
            Abdul founded VantriqSec to bring direct, practical security work to
            businesses that are often priced out of traditional security
            services. He leads engagements end to end — from scoping and testing
            through to the conversation afterward about what actually matters to
            fix first.
          </p>
          <a
            href={FOUNDER.portfolioUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-block text-sm font-semibold text-brand-500 hover:text-brand-400"
          >
            View portfolio →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-surface-800 bg-surface-900">
    <div class="mx-auto max-w-4xl px-6 py-20 text-center">
      <h2 class="text-3xl font-bold sm:text-4xl">Want to work with us?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-text-secondary">
        Tell us about your business and what you're trying to protect.
      </p>
      <div class="mt-8">
        <Button href="/contact" variant="primary">Get in touch</Button>
      </div>
    </div>
  </section>
</BaseLayout>
