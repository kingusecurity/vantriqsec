---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class="text-sm font-semibold uppercase tracking-wide text-brand-500">{eyebrow}</p>}
  <h2 class="mt-2 text-3xl font-bold sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg text-text-secondary">{description}</p>}
</div>
