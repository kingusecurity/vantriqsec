---
// JSON-LD Organization schema, site-wide. `application/ld+json` blocks
// are data, not executable script, so they're unaffected by the
// script-src 'self' CSP (see README's "Content Security Policy" section)
// — no CSP change needed for this.

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : '';

// No dedicated logo asset exists yet — reusing the favicon SVG as a
// stand-in. Replace with a proper brand logo (schema.org/Google prefer
// a raster image) once one is designed.
const logoUrl = Astro.site ? new URL('/favicon.svg', Astro.site).toString() : '';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'VantriqSec',
  url: siteUrl,
  logo: logoUrl,
  contactPoint: [
    {
      '@type': 'ContactPoint',
      email: 'hello@vantriqsec.com',
      contactType: 'customer service',
      areaServed: 'PK',
      availableLanguage: ['English'],
    },
  ],
  // TODO: X/LinkedIn placeholders — replace with real profile URLs
  // before launch; these intentionally don't resolve as-is. GitHub is
  // real: https://github.com/VANTRIQ (repo name unchanged by the brand
  // rename, per explicit instruction).
  sameAs: [
    'https://github.com/VANTRIQ',
    'https://x.com/TODO_vantriqsec_set_real_handle',
    'https://www.linkedin.com/company/TODO_vantriqsec_set_real_handle',
  ],
  // Deliberately minimal: name + jobTitle + a link to the portfolio only.
  // No address/email/phone/birthDate — those fields exist on schema.org's
  // Person type but nothing about this site needs them, and adding them
  // would publish personal data that has no reason to be machine-readable.
  founder: {
    '@type': 'Person',
    name: 'Abdul Mannan',
    jobTitle: 'Founder & CEO',
    url: 'https://abdul-mannan-portfolio-umber.vercel.app/',
  },
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
