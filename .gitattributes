* text=auto

# Explicit, so text=auto's auto-detection can never misfire on these —
# the actual binary assets in this repo.
*.ttf binary
*.woff binary
*.woff2 binary
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary

# Shell scripts always need LF, even on a Windows checkout — a CRLF
# shebang line breaks execution.
.githooks/* text eol=lf
