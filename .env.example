# Turso (libSQL) — create with `turso db create sipar-security`
# then `turso db show sipar-security --url` and `turso db tokens create sipar-security`
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=replace-with-real-token

# Resend — https://resend.com, verify a sending domain before going live
RESEND_API_KEY=re_replace_with_real_key
CONTACT_TO_EMAIL=hello@siparsecurity.example
