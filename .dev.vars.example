# Wrangler's local-secrets convention file. Copy to .dev.vars (gitignored)
# for local `astro dev`/`wrangler dev` — Node's `--env-file` flag also
# reads this same file for scripts/test-contact.mjs, so there's one local
# secrets file, not two.

# Turso (libSQL) — create with `turso db create vantriqsec`
# then `turso db show vantriqsec --url` and `turso db tokens create vantriqsec`
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=replace-with-real-token

# Resend — https://resend.com, verify a sending domain before going live
RESEND_API_KEY=re_replace_with_real_key
CONTACT_TO_EMAIL=hello@vantriqsec.example

# Signs the contact form's server-issued time-trap token (see
# src/lib/contactToken.ts). Generate with: openssl rand -hex 32
CONTACT_TOKEN_SECRET=replace-with-a-random-64-char-hex-string
